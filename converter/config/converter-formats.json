{
  "version": "0.2",
  "notes": [
    "The Converter is CPU-first. CUDA is never required.",
    "splat-transform is the preferred conversion tool when it is installed in the runtime image.",
    "Targets without an available stable tool are reported as skipped."
  ],
  "targets": {
    "spz": {
      "label": "SPZ",
      "extension": ".spz",
      "tool": "splat-transform",
      "command_variants": [
        ["splat-transform", "-g", "cpu", "{input}", "{output}"],
        ["splat-transform", "{input}", "{output}"],
        ["splat-transform", "--input", "{input}", "--output", "{output}"]
      ]
    },
    "sog": {
      "label": "SOG",
      "extension": ".sog",
      "tool": "splat-transform",
      "command_variants": [
        ["splat-transform", "-g", "cpu", "{input}", "{output}"],
        ["splat-transform", "{input}", "{output}"],
        ["splat-transform", "--input", "{input}", "--output", "{output}"]
      ]
    },
    "streamed-sog": {
      "label": "Streamed SOG / LOD",
      "extension": ".json",
      "output_name": "lod-meta.json",
      "tool": "splat-transform",
      "subdir": "streamed-sog",
      "command_variants": [
        ["splat-transform", "-g", "cpu", "{input}", "-l", "0", "{output}"],
        ["splat-transform", "{input}", "-l", "0", "{output}"]
      ]
    },
    "compressed-ply": {
      "label": "Compressed PLY",
      "extension": ".compressed.ply",
      "tool": "splat-transform",
      "command_variants": [
        ["splat-transform", "-g", "cpu", "{input}", "{output}"],
        ["splat-transform", "{input}", "{output}"]
      ]
    },
    "html-viewer": {
      "label": "HTML viewer",
      "extension": ".html",
      "tool": "splat-transform",
      "builtin_fallback": "html_viewer",
      "command_variants": [
        ["splat-transform", "-g", "cpu", "{input}", "{output}"],
        ["splat-transform", "{input}", "{output}"]
      ]
    },
    "voxel-collision": {
      "label": "Voxel collision",
      "extension": ".collision.json",
      "tool": "converter-builtin",
      "builtin": "voxel_collision"
    },
    "splat": {
      "label": "SPLAT",
      "extension": ".splat",
      "tool": "splat-transform",
      "command_variants": [
        ["splat-transform", "-g", "cpu", "{input}", "{output}"],
        ["splat-transform", "{input}", "{output}"],
        ["splat-transform", "--input", "{input}", "--output", "{output}"]
      ]
    },
    "ksplat": {
      "label": "KSPLAT",
      "extension": ".ksplat",
      "tool": "splat-transform",
      "command_variants": [
        ["splat-transform", "-g", "cpu", "{input}", "{output}"],
        ["splat-transform", "{input}", "{output}"],
        ["splat-transform", "--input", "{input}", "--output", "{output}"]
      ]
    }
  }
}
